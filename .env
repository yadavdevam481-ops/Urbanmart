PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/urbankart
JWT_SECRET=urbankart_super_secret_change_this_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay (get test keys: Razorpay Dashboard -> Settings -> API Keys, Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks (URL: https://YOUR_DOMAIN/api/payment/webhook)
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string
